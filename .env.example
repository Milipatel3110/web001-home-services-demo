# ---------------------------------------------------------------------------
# FRONTEND (Vite) - public values only; everything VITE_* ends up in the browser.
# Local dev: copy to .env.local. CI: GitHub > Settings > Secrets and variables >
# Actions > Variables tab (VITE_BASE_PATH is set in deploy.yml).
# ---------------------------------------------------------------------------
VITE_CONTACT_FUNCTION_URL=https://<project-ref>.supabase.co/functions/v1/contact-submit
# Optional base path override. Empty = /web001-home-services-demo/ for
# `npm run build`, / for `npm run dev`.
VITE_BASE_PATH=

# ---------------------------------------------------------------------------
# SERVER-ONLY - never put these in this file, Git, GitHub variables or Vite.
# Listed for reference only; set them where indicated.
# ---------------------------------------------------------------------------
# Supabase Edge Function secrets (supabase secrets set ... / Dashboard > Edge Functions > Secrets):
#   WINDMILL_WEBHOOK_URL=https://<windmill-host>/api/w/<workspace>/jobs/run_wait_result/f/web001/contact_intake
#   WINDMILL_WEBHOOK_TOKEN=<windmill token scoped to this flow>
#   ALLOWED_ORIGINS=https://<github-user>.github.io,http://localhost:5173
#   UPSTREAM_TIMEOUT_MS=15000            (optional)
#
# Windmill secret variables (workspace <workspace>):
#   f/web001/supabase_url          = https://<project-ref>.supabase.co
#   f/web001/supabase_service_key  = <sb_secret_... or legacy service_role key>  (mark as secret)
